{
  "name": "@knocklet/desktop",
  "version": "0.2.1",
  "description": "Local LinkedIn outreach desktop application",
  "author": "Om Shejul",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "predist": "install-electron --no",
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "test:tray-smoke": "electron tests/tray-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.omshejul.knocklet",
    "productName": "Knocklet",
    "artifactName": "Knocklet-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "omshejul",
        "repo": "knocklet"
      }
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      },
      {
        "from": "runtime-dist/knocklet-runtime",
        "to": "runtime"
      },
      {
        "from": "assets",
        "to": ".",
        "filter": [
          "menuTemplate.png",
          "menuTemplate@2x.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true
      },
      "icon": "assets/AppIcon.icon",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "13.0",
      "signIgnore": [
        "/Contents/Resources/runtime/(?!.*(?:knocklet-runtime|\\.dylib|\\.so)$)",
        "/Contents/Resources/web/",
        "/Contents/Resources/app\\.asar$",
        "/Electron Framework\\.framework/(?:Versions/(?:A|Current)/)?Resources/"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Knocklet ${version}",
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
